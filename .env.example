# Local development uses the Docker Postgres container. Set the production
# DATABASE_URL to the Neon connection string in Vercel.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/main"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated website-team accounts. Keep server-only; never expose with a
# NEXT_PUBLIC_ prefix.
PLATFORM_ADMIN_EMAILS=""

# Production-only Princeton TigerNet OIDC credentials.
TIGERNET_CLIENT_ID=""
TIGERNET_CLIENT_SECRET=""
TIGERNET_ISSUER_URL=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Princeton Meal Exchange <onboarding@resend.dev>"

# Optional local preview identity for flows that require authentication. This
# only works under `next dev`; tests and production always use Better Auth.
DEV_BYPASS_AUTH="false"
